{
  "name": "drawing",
  "description": "An agent makes the drawing a shop works from and hands over its PDF: a 60 x 40 x 20 mm block with a 10 mm hole through it at (20, 20), and a 10 mm pin 30 mm long, each sketched on its front plane and extruded up +Z, then saved; an assembly of the block fixed at the origin and the pin standing in the hole, with an exploded view that pulls the pin 40 mm along y, saved. A new A3 drawing at 1:1 in third-angle projection gets its title and part number through its properties; Sheet1 shows the block's front view with its top view above and its right view beside it, projected, and section A through the hole's axis below; the block's own dimensions are imported into the three views; reference dimensions give its width and the hole's diameter; datum A sits on the bottom edge and a position tolerance of 0.1 to A on the hole. An Assembly sheet shows the assembly exploded with a bill of materials and balloons numbered to it. The drawing is saved and exported as PDF. Every edge is named by a reference model.find issued in the block, selected through the front view. Variables: part, pin (the .SLDPRT files to create), asm (the .SLDASM to create), drawing (the .SLDDRW to create) and pdf (the .pdf to write).",
  "steps": [
    { "say": "the block part, saved where it was asked for", "tool": "sw_document_new", "arguments": { "path": "${part}" } },
    { "say": "its 60 x 40 outline", "tool": "sw_sketch_create", "arguments": { "document": "${part}", "on": "front", "name": "outline", "rectangles": [ { "id": "b", "corner1": { "x": 0, "y": 0 }, "corner2": { "x": 60, "y": 40 } } ] }, "save": { "part_outline": "/sketch/name" } },
    { "say": "20 mm thick", "tool": "sw_feature_extrude", "arguments": { "document": "${part}", "sketch": "${part_outline}", "depth_mm": 20 } },
    { "say": "a 10 mm hole at (20, 20)", "tool": "sw_sketch_create", "arguments": { "document": "${part}", "on": "front", "name": "hole", "circles": [ { "id": "h", "center": { "x": 20, "y": 20 }, "radius_mm": 5 } ] }, "save": { "part_hole": "/sketch/name" } },
    { "say": "cut through", "tool": "sw_feature_extrude", "arguments": { "document": "${part}", "sketch": "${part_hole}", "mode": "cut", "end": "through_all" } },
    { "say": "save the block", "tool": "sw_document_save", "arguments": { "document": "${part}" } },
    { "say": "the pin part", "tool": "sw_document_new", "arguments": { "path": "${pin}" } },
    { "say": "a 10 mm circle", "tool": "sw_sketch_create", "arguments": { "document": "${pin}", "on": "front", "name": "section", "circles": [ { "id": "c", "center": { "x": 0, "y": 0 }, "radius_mm": 5 } ] }, "save": { "pin_section": "/sketch/name" } },
    { "say": "30 mm long", "tool": "sw_feature_extrude", "arguments": { "document": "${pin}", "sketch": "${pin_section}", "depth_mm": 30 } },
    { "say": "save the pin", "tool": "sw_document_save", "arguments": { "document": "${pin}" } },
    { "say": "a new assembly", "tool": "sw_document_new", "arguments": { "type": "assembly", "path": "${asm}" } },
    { "say": "the block, fixed at the origin", "tool": "sw_assembly_insert", "arguments": { "document": "${asm}", "path": "${part}", "at": { "x": 0, "y": 0, "z": 0 }, "fixed": true }, "save": { "block_c": "/component/name" } },
    { "say": "the pin standing in the hole", "tool": "sw_assembly_insert", "arguments": { "document": "${asm}", "path": "${pin}", "at": { "x": 20, "y": 20, "z": 0 }, "fixed": true }, "save": { "pin_c": "/component/name" } },
    { "say": "an exploded view with the pin pulled out along y", "tool": "sw_explode_create", "arguments": { "document": "${asm}", "steps": [ { "components": [ "${pin_c}" ], "direction": "y", "distance_mm": 40 } ] }, "save": { "exploded": "/view/name" } },
    { "say": "save the assembly", "tool": "sw_document_save", "arguments": { "document": "${asm}" } },
    { "say": "a new A3 drawing at 1:1, third angle", "tool": "sw_document_new", "arguments": { "type": "drawing", "path": "${drawing}", "sheet": { "size": "a3", "orientation": "landscape", "scale": { "numerator": 1, "denominator": 1 }, "projection": "third_angle" } } },
    { "say": "the title block's title and part number", "tool": "sw_drawing_properties", "arguments": { "document": "${drawing}", "set": [ { "name": "Title", "value": "MAKE-A-DRAWING BLOCK" }, { "name": "PartNo", "value": "SWMCP-0002" } ] } },
    { "say": "the block's front view", "tool": "sw_view_create", "arguments": { "document": "${drawing}", "model": "${part}", "orientation": "front", "at": { "x": 110, "y": 180 } }, "save": { "front": "/view/name" } },
    { "say": "its top view above it", "tool": "sw_view_project", "arguments": { "document": "${drawing}", "parent": "${front}", "direction": "above" }, "save": { "top": "/view/name" } },
    { "say": "its right view beside it", "tool": "sw_view_project", "arguments": { "document": "${drawing}", "parent": "${front}", "direction": "right" }, "save": { "right": "/view/name" } },
    { "say": "the hole's front edge, named in the block", "tool": "sw_model_find", "arguments": { "document": "${part}", "kind": "edge", "geometry": "circle", "near": { "x": 25, "y": 20, "z": 20 }, "max_distance_mm": 0.001, "limit": 1 }, "save": { "hole_edge": "/entities/0/reference" } },
    { "say": "section A through the hole's axis, below the front", "tool": "sw_view_section", "arguments": { "document": "${drawing}", "parent": "${front}", "cut": { "through": { "reference": "${hole_edge}" }, "orientation": "horizontal" } }, "save": { "section": "/view/name", "section_label": "/label", "hatched_area": "/hatched_area_mm2" } },
    { "say": "the block's own dimensions in the three views", "tool": "sw_annotation_import", "arguments": { "document": "${drawing}", "views": [ "${front}", "${top}", "${right}" ], "types": [ "dimensions" ] }, "save": { "imported": "/dimensions" } },
    { "say": "the block's left front edge", "tool": "sw_model_find", "arguments": { "document": "${part}", "kind": "edge", "geometry": "line", "near": { "x": 0, "y": 20, "z": 20 }, "max_distance_mm": 0.001, "limit": 1 }, "save": { "left": "/entities/0/reference" } },
    { "say": "its right front edge", "tool": "sw_model_find", "arguments": { "document": "${part}", "kind": "edge", "geometry": "line", "near": { "x": 60, "y": 20, "z": 20 }, "max_distance_mm": 0.001, "limit": 1 }, "save": { "right_edge": "/entities/0/reference" } },
    { "say": "its bottom front edge", "tool": "sw_model_find", "arguments": { "document": "${part}", "kind": "edge", "geometry": "line", "near": { "x": 30, "y": 0, "z": 20 }, "max_distance_mm": 0.001, "limit": 1 }, "save": { "bottom": "/entities/0/reference" } },
    { "say": "the width between the sides", "tool": "sw_annotation_dimension", "arguments": { "document": "${drawing}", "kind": "horizontal", "entities": [ { "view": "${front}", "reference": "${left}" }, { "view": "${front}", "reference": "${right_edge}" } ], "at": { "x": 95, "y": 152 } }, "save": { "width": "/value" } },
    { "say": "the hole's diameter", "tool": "sw_annotation_dimension", "arguments": { "document": "${drawing}", "kind": "diameter", "entities": [ { "view": "${front}", "reference": "${hole_edge}" } ], "at": { "x": 70, "y": 205 } }, "save": { "diameter": "/value" } },
    { "say": "datum A on the bottom edge", "tool": "sw_annotation_datum", "arguments": { "document": "${drawing}", "label": "A", "attach_to": { "view": "${front}", "reference": "${bottom}" }, "at": { "x": 130, "y": 150 } }, "save": { "datum": "/annotation/name" } },
    { "say": "the hole's position, 0.1 diameter to A", "tool": "sw_annotation_gtol", "arguments": { "document": "${drawing}", "characteristic": "position", "tolerance_mm": 0.1, "diameter": true, "datums": [ "A" ], "attach_to": { "view": "${front}", "reference": "${hole_edge}" }, "at": { "x": 55, "y": 215 } }, "save": { "gtol": "/annotation/name" } },
    { "say": "a sheet for the assembly", "tool": "sw_sheet_add", "arguments": { "document": "${drawing}", "name": "Assembly", "size": "a3", "orientation": "landscape", "scale": { "numerator": 1, "denominator": 1 } } },
    { "say": "the assembly exploded", "tool": "sw_view_create", "arguments": { "document": "${drawing}", "sheet": "Assembly", "model": "${asm}", "orientation": "front", "at": { "x": 200, "y": 150 }, "exploded": true }, "save": { "asm_view": "/view/name" } },
    { "say": "its bill of materials, top left", "tool": "sw_table_bom", "arguments": { "document": "${drawing}", "view": "${asm_view}", "kind": "top_level", "at": { "x": 20, "y": 280 }, "anchor": "top_left" }, "save": { "bom_rows": "/table/rows" } },
    { "say": "balloons numbered to it", "tool": "sw_annotation_balloons", "arguments": { "document": "${drawing}", "view": "${asm_view}", "layout": "square" }, "save": { "balloons": "/made" } },
    { "say": "save the drawing, and any model it shows that changed", "tool": "sw_document_save", "arguments": { "document": "${drawing}" } },
    { "say": "the drawing as PDF", "tool": "sw_export_drawing", "arguments": { "document": "${drawing}", "path": "${pdf}", "format": "pdf" }, "save": { "pdf_sheets": "/sheets", "pdf_pages": "/files/0/pages", "pdf_marked_dirty": "/marked_dirty" } }
  ]
}
