{
  "name": "stand",
  "description": "An agent builds a pinned bracket on a plate and hands over its STEP file: an 80 x 40 x 10 mm plate with two 10 mm holes at (20, 20) and (60, 20); a 40 x 20 x 10 mm bracket with a 10 mm hole at (10, 10); a 10 mm pin 20 mm long; each sketched on its front plane and extruded up +Z, then saved. In a new assembly the plate is fixed at the origin, the bracket sits on it with its hole on the plate's first hole and its right plane parallel to the plate's, and the pin goes through both holes, its bottom flush with the plate's bottom and its right plane parallel to the plate's. The pin's side face is named in its own part ({component, entity}), the planes by name@component, everything else by assembly reference. The agent checks the degrees of freedom and interference, explodes the pin out, saves, and exports STEP. Variables: plate, bracket, pin (the .SLDPRT files to create), asm (the .SLDASM to create) and step (the .step to write).",
  "steps": [
    { "say": "the plate part, saved where it was asked for", "tool": "sw_document_new", "arguments": { "path": "${plate}" } },
    { "say": "its 80 x 40 outline", "tool": "sw_sketch_create", "arguments": { "document": "${plate}", "on": "front", "name": "outline", "rectangles": [ { "id": "p", "corner1": { "x": 0, "y": 0 }, "corner2": { "x": 80, "y": 40 } } ] }, "save": { "plate_outline": "/sketch/name" } },
    { "say": "10 mm thick", "tool": "sw_feature_extrude", "arguments": { "document": "${plate}", "sketch": "${plate_outline}", "depth_mm": 10 } },
    { "say": "two 10 mm holes", "tool": "sw_sketch_create", "arguments": { "document": "${plate}", "on": "front", "name": "holes", "circles": [ { "id": "h1", "center": { "x": 20, "y": 20 }, "radius_mm": 5 }, { "id": "h2", "center": { "x": 60, "y": 20 }, "radius_mm": 5 } ] }, "save": { "plate_holes": "/sketch/name" } },
    { "say": "cut through", "tool": "sw_feature_extrude", "arguments": { "document": "${plate}", "sketch": "${plate_holes}", "mode": "cut", "end": "through_all" } },
    { "say": "save the plate", "tool": "sw_document_save", "arguments": { "document": "${plate}" } },
    { "say": "the bracket part", "tool": "sw_document_new", "arguments": { "path": "${bracket}" } },
    { "say": "its 40 x 20 outline", "tool": "sw_sketch_create", "arguments": { "document": "${bracket}", "on": "front", "name": "outline", "rectangles": [ { "id": "b", "corner1": { "x": 0, "y": 0 }, "corner2": { "x": 40, "y": 20 } } ] }, "save": { "bracket_outline": "/sketch/name" } },
    { "say": "10 mm thick", "tool": "sw_feature_extrude", "arguments": { "document": "${bracket}", "sketch": "${bracket_outline}", "depth_mm": 10 } },
    { "say": "its 10 mm pin hole", "tool": "sw_sketch_create", "arguments": { "document": "${bracket}", "on": "front", "name": "hole", "circles": [ { "id": "h", "center": { "x": 10, "y": 10 }, "radius_mm": 5 } ] }, "save": { "bracket_hole_sketch": "/sketch/name" } },
    { "say": "cut through", "tool": "sw_feature_extrude", "arguments": { "document": "${bracket}", "sketch": "${bracket_hole_sketch}", "mode": "cut", "end": "through_all" } },
    { "say": "save the bracket", "tool": "sw_document_save", "arguments": { "document": "${bracket}" } },
    { "say": "the pin part", "tool": "sw_document_new", "arguments": { "path": "${pin}" } },
    { "say": "a 10 mm circle", "tool": "sw_sketch_create", "arguments": { "document": "${pin}", "on": "front", "name": "section", "circles": [ { "id": "c", "center": { "x": 0, "y": 0 }, "radius_mm": 5 } ] }, "save": { "pin_section": "/sketch/name" } },
    { "say": "20 mm long", "tool": "sw_feature_extrude", "arguments": { "document": "${pin}", "sketch": "${pin_section}", "depth_mm": 20 } },
    { "say": "save the pin", "tool": "sw_document_save", "arguments": { "document": "${pin}" } },
    { "say": "the pin's side face, named in its own part", "tool": "sw_model_find", "arguments": { "document": "${pin}", "kind": "face", "geometry": "cylinder" }, "save": { "pin_side_part": "/entities/0/reference" } },
    { "say": "a new assembly", "tool": "sw_document_new", "arguments": { "type": "assembly", "path": "${asm}" } },
    { "say": "the plate first, fixed at the origin", "tool": "sw_assembly_insert", "arguments": { "document": "${asm}", "path": "${plate}" }, "save": { "plate_c": "/component/name" } },
    { "say": "the bracket above it, near where it goes", "tool": "sw_assembly_insert", "arguments": { "document": "${asm}", "path": "${bracket}", "at": { "x": 15, "y": 15, "z": 30 } }, "save": { "bracket_c": "/component/name" } },
    { "say": "the pin off to the side", "tool": "sw_assembly_insert", "arguments": { "document": "${asm}", "path": "${pin}", "at": { "x": 100, "y": 0, "z": 0 } }, "save": { "pin_c": "/component/name" } },
    { "say": "the plate's top face", "tool": "sw_model_find", "arguments": { "document": "${asm}", "component": "${plate_c}", "kind": "face", "geometry": "plane", "direction": { "x": 0, "y": 0, "z": 1 } }, "save": { "plate_top": "/entities/0/reference" } },
    { "say": "the bracket's bottom face", "tool": "sw_model_find", "arguments": { "document": "${asm}", "component": "${bracket_c}", "kind": "face", "geometry": "plane", "direction": { "x": 0, "y": 0, "z": -1 } }, "save": { "bracket_bottom": "/entities/0/reference" } },
    { "say": "the bracket sits on the plate", "tool": "sw_mate_add", "arguments": { "document": "${asm}", "type": "coincident", "entities": [ { "entity": "${bracket_bottom}" }, { "entity": "${plate_top}" } ] }, "save": { "seat": "/mate/name" } },
    { "say": "the plate's first hole", "tool": "sw_model_find", "arguments": { "document": "${asm}", "component": "${plate_c}", "kind": "face", "geometry": "cylinder", "near": { "x": 20, "y": 20, "z": 5 }, "max_distance_mm": 6, "limit": 1 }, "save": { "plate_hole": "/entities/0/reference" } },
    { "say": "the bracket's hole", "tool": "sw_model_find", "arguments": { "document": "${asm}", "component": "${bracket_c}", "kind": "face", "geometry": "cylinder" }, "save": { "bracket_hole": "/entities/0/reference" } },
    { "say": "the holes line up", "tool": "sw_mate_add", "arguments": { "document": "${asm}", "type": "concentric", "entities": [ { "entity": "${bracket_hole}" }, { "entity": "${plate_hole}" } ] }, "save": { "line_up": "/mate/name" } },
    { "say": "the bracket square to the plate", "tool": "sw_mate_add", "arguments": { "document": "${asm}", "type": "parallel", "alignment": "aligned", "entities": [ { "entity": "right@${bracket_c}" }, { "entity": "right@${plate_c}" } ] }, "save": { "square": "/mate/name" } },
    { "say": "the pin through the bracket's hole, its side face named in the pin's part", "tool": "sw_mate_add", "arguments": { "document": "${asm}", "type": "concentric", "entities": [ { "component": "${pin_c}", "entity": "${pin_side_part}" }, { "entity": "${bracket_hole}" } ] }, "save": { "pin_in": "/mate/name" } },
    { "say": "the pin's bottom face", "tool": "sw_model_find", "arguments": { "document": "${asm}", "component": "${pin_c}", "kind": "face", "geometry": "plane", "direction": { "x": 0, "y": 0, "z": -1 } }, "save": { "pin_bottom": "/entities/0/reference" } },
    { "say": "the plate's bottom face", "tool": "sw_model_find", "arguments": { "document": "${asm}", "component": "${plate_c}", "kind": "face", "geometry": "plane", "direction": { "x": 0, "y": 0, "z": -1 } }, "save": { "plate_bottom": "/entities/0/reference" } },
    { "say": "the pin flush with the plate's bottom", "tool": "sw_mate_add", "arguments": { "document": "${asm}", "type": "coincident", "entities": [ { "entity": "${pin_bottom}" }, { "entity": "${plate_bottom}" } ] }, "save": { "flush": "/mate/name" } },
    { "say": "the pin square to the plate", "tool": "sw_mate_add", "arguments": { "document": "${asm}", "type": "parallel", "alignment": "aligned", "entities": [ { "entity": "right@${pin_c}" }, { "entity": "right@${plate_c}" } ] }, "save": { "pin_square": "/mate/name" } },
    { "say": "is everything held?", "tool": "sw_assembly_dof", "arguments": { "document": "${asm}" }, "save": { "dof": "/components" } },
    { "say": "does anything overlap?", "tool": "sw_assembly_interference", "arguments": { "document": "${asm}" }, "save": { "interferences": "/interferences" } },
    { "say": "an exploded view with the pin pulled out", "tool": "sw_explode_create", "arguments": { "document": "${asm}", "name": "Pin out", "steps": [ { "components": [ "${pin_c}" ], "direction": "z", "distance_mm": 40 } ] }, "save": { "view": "/view/name", "explode_sense": "/steps/0/sense" } },
    { "say": "save the assembly, and any part it changed", "tool": "sw_document_save", "arguments": { "document": "${asm}" } },
    { "say": "the assembly as STEP", "tool": "sw_export_assembly", "arguments": { "document": "${asm}", "path": "${step}", "format": "step" }, "save": { "step_occurrences": "/step_occurrences", "step_components": "/components" } }
  ]
}
