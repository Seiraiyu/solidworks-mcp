{
  "type": "object",
  "description": "Features suppressed or unsuppressed, and the part after it.",
  "properties": {
    "change": {
      "type": "object",
      "properties": {
        "document": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "The document's title as SOLIDWORKS shows it."
            },
            "path": {
              "type": "string",
              "description": "The full path, absent while the document has never been saved."
            },
            "type": {
              "type": "string",
              "enum": [
                "part",
                "assembly",
                "drawing"
              ],
              "description": "Part, assembly or drawing."
            },
            "dirty": {
              "type": "boolean",
              "description": "True when the document has unsaved changes."
            },
            "visible": {
              "type": "boolean",
              "description": "False for a document SOLIDWORKS loaded only because an open assembly uses it: it has no window of its own."
            }
          },
          "required": [
            "title",
            "type",
            "dirty",
            "visible"
          ],
          "additionalProperties": false,
          "description": "The part it acted on."
        },
        "created": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "Something a model-changing operation made.",
            "properties": {
              "name": {
                "type": "string",
                "description": "Its name, for example Sketch3 or Line2."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "face",
                  "edge",
                  "vertex",
                  "feature",
                  "sketch",
                  "sketch_entity",
                  "sketch_point",
                  "plane",
                  "axis",
                  "point",
                  "dimension",
                  "component",
                  "mate",
                  "sheet",
                  "view",
                  "annotation",
                  "table"
                ],
                "description": "What it is: feature, sketch, sketch_entity, sketch_point, dimension, plane, axis or point; component or mate in an assembly; sheet or view on a drawing."
              },
              "reference": {
                "type": "string",
                "description": "Its persistent reference; absent when SOLIDWORKS gives none. References are opaque: pass one back exactly as it was given, and never build or change one."
              }
            },
            "required": [
              "name",
              "kind"
            ],
            "additionalProperties": false
          },
          "description": "What it made (features, sketches, sketch entities), in the order it made them."
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "A value a model-changing operation edited.",
            "properties": {
              "name": {
                "type": "string",
                "description": "What was edited, for example D1@Sketch1."
              },
              "property": {
                "type": "string",
                "description": "Which of its properties: value, or suppressed."
              },
              "before": {
                "type": "string",
                "description": "Its value before, with its unit, for example 40 mm."
              },
              "after": {
                "type": "string",
                "description": "Its value after, with its unit."
              }
            },
            "required": [
              "name",
              "property",
              "before",
              "after"
            ],
            "additionalProperties": false
          },
          "description": "What it edited, each with its value before and after."
        },
        "rebuild": {
          "type": "object",
          "properties": {
            "errors": {
              "type": "integer",
              "description": "How many features have a rebuild error."
            },
            "warnings": {
              "type": "integer",
              "description": "How many features have a rebuild warning."
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "description": "A feature with a rebuild error or warning.",
                "properties": {
                  "feature": {
                    "type": "string",
                    "description": "The feature's name."
                  },
                  "code": {
                    "type": "string",
                    "description": "SOLIDWORKS' error code name (swFeatureError_e), for example swFeatureErrorFilletNoEdge."
                  },
                  "warning": {
                    "type": "boolean",
                    "description": "True for a warning, false for an error."
                  }
                },
                "required": [
                  "feature",
                  "code",
                  "warning"
                ],
                "additionalProperties": false
              },
              "description": "Each feature with an error or warning."
            }
          },
          "required": [
            "errors",
            "warnings",
            "items"
          ],
          "additionalProperties": false,
          "description": "The part's rebuild errors and warnings after the change, by feature."
        },
        "bodies_before": {
          "type": "integer",
          "description": "Solid bodies before the change."
        },
        "bodies_after": {
          "type": "integer",
          "description": "Solid bodies after the change."
        },
        "volume_before_mm3": {
          "type": "number",
          "description": "Volume of the solid bodies before the change, mm³."
        },
        "volume_after_mm3": {
          "type": "number",
          "description": "Volume of the solid bodies after the change, mm³."
        },
        "box": {
          "type": "object",
          "properties": {
            "min": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "description": "X, mm."
                },
                "y": {
                  "type": "number",
                  "description": "Y, mm."
                },
                "z": {
                  "type": "number",
                  "description": "Z, mm."
                }
              },
              "required": [
                "x",
                "y",
                "z"
              ],
              "additionalProperties": false,
              "description": "The corner with the smallest coordinates."
            },
            "max": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "description": "X, mm."
                },
                "y": {
                  "type": "number",
                  "description": "Y, mm."
                },
                "z": {
                  "type": "number",
                  "description": "Z, mm."
                }
              },
              "required": [
                "x",
                "y",
                "z"
              ],
              "additionalProperties": false,
              "description": "The corner with the largest coordinates."
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false,
          "description": "The box around the solid bodies after the change (SOLIDWORKS' quick box), mm; absent when the part has no solid body."
        }
      },
      "required": [
        "document",
        "created",
        "changed",
        "rebuild",
        "bodies_before",
        "bodies_after",
        "volume_before_mm3",
        "volume_after_mm3"
      ],
      "additionalProperties": false,
      "description": "The evidence: each feature's suppression before and after, and the part rebuilt."
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "A face, edge, vertex, feature, plane, axis or point, with its reference and a short geometric description. Lengths in mm, areas in mm².",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "face",
              "edge",
              "vertex",
              "feature",
              "sketch",
              "sketch_entity",
              "sketch_point",
              "plane",
              "axis",
              "point",
              "dimension",
              "component",
              "mate",
              "sheet",
              "view",
              "annotation",
              "table"
            ],
            "description": "What it is."
          },
          "reference": {
            "type": "string",
            "description": "Its persistent reference (r1.<kind>.…), to pass to other operations; absent when SOLIDWORKS cannot give one. References are opaque: pass one back exactly as it was given, and never build or change one."
          },
          "name": {
            "type": "string",
            "description": "Its name, for features, planes, axes and points."
          },
          "component": {
            "type": "string",
            "description": "In an assembly, the component it belongs to (bracket-1; sub-1/pin-1 inside a subassembly); absent for the assembly's own planes, axes and origin, and in a part. Its position, direction and box are in the assembly's coordinates."
          },
          "feature": {
            "type": "string",
            "description": "The feature that made it, for faces, edges and vertices. An edge or vertex where several features meet names the first; see features."
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "For edges and vertices, every feature that made a face it lies on: the circular edge of a hole cut in a boss belongs to both."
          },
          "geometry": {
            "type": "string",
            "enum": [
              "plane",
              "cylinder",
              "cone",
              "sphere",
              "torus",
              "line",
              "circle",
              "ellipse",
              "spline",
              "point",
              "other"
            ],
            "description": "Its shape: plane, cylinder, cone, sphere, torus, line, circle, ellipse, spline, point or other."
          },
          "area_mm2": {
            "type": "number",
            "description": "Area of a face, mm²."
          },
          "length_mm": {
            "type": "number",
            "description": "Length of an edge, mm."
          },
          "normal": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "description": "X component."
              },
              "y": {
                "type": "number",
                "description": "Y component."
              },
              "z": {
                "type": "number",
                "description": "Z component."
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "additionalProperties": false,
            "description": "Outward normal of a planar face, or the normal of a plane."
          },
          "axis": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "description": "X component."
              },
              "y": {
                "type": "number",
                "description": "Y component."
              },
              "z": {
                "type": "number",
                "description": "Z component."
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "additionalProperties": false,
            "description": "Axis of a cylinder, cone, circle or axis; direction of a line."
          },
          "origin": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "description": "X, mm."
              },
              "y": {
                "type": "number",
                "description": "Y, mm."
              },
              "z": {
                "type": "number",
                "description": "Z, mm."
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "additionalProperties": false,
            "description": "A point on it: a planar face's or edge's centre, a circle's or cylinder's centre on its axis, a vertex or point itself."
          },
          "radius_mm": {
            "type": "number",
            "description": "Radius of a cylinder, cone base, sphere, torus or circle, mm."
          },
          "box": {
            "type": "object",
            "properties": {
              "min": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "description": "X, mm."
                  },
                  "y": {
                    "type": "number",
                    "description": "Y, mm."
                  },
                  "z": {
                    "type": "number",
                    "description": "Z, mm."
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false,
                "description": "The corner with the smallest coordinates."
              },
              "max": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "description": "X, mm."
                  },
                  "y": {
                    "type": "number",
                    "description": "Y, mm."
                  },
                  "z": {
                    "type": "number",
                    "description": "Z, mm."
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false,
                "description": "The corner with the largest coordinates."
              }
            },
            "required": [
              "min",
              "max"
            ],
            "additionalProperties": false,
            "description": "Its axis-aligned bounding box, for faces only."
          },
          "distance_mm": {
            "type": "number",
            "description": "Distance from the point model.find was asked to be near, mm."
          }
        },
        "required": [
          "kind",
          "geometry"
        ],
        "additionalProperties": false
      },
      "description": "The features named, as they are now."
    },
    "unchanged": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Features named that were already as asked, and left alone."
    }
  },
  "required": [
    "change",
    "features",
    "unchanged"
  ],
  "additionalProperties": false
}
