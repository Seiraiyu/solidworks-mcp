{
  "type": "object",
  "description": "The user's selection changed in a part (raised once it has been still for 250 ms; never for the add-in's own selections).",
  "properties": {
    "title": {
      "type": "string",
      "description": "The part's title."
    },
    "path": {
      "type": "string",
      "description": "Its full path, absent while unsaved."
    },
    "total": {
      "type": "integer",
      "description": "How many items are selected now."
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "One selected item.",
        "properties": {
          "type": {
            "type": "string",
            "description": "What SOLIDWORKS says it is: face, edge, vertex, plane, axis, point, sketch, sketch_segment, sketch_point, dimension, feature, solid_body or other."
          },
          "entity": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "face",
                  "edge",
                  "vertex",
                  "feature",
                  "sketch",
                  "sketch_entity",
                  "sketch_point",
                  "plane",
                  "axis",
                  "point",
                  "dimension",
                  "component",
                  "mate"
                ],
                "description": "What it is."
              },
              "reference": {
                "type": "string",
                "description": "Its persistent reference (r1.<kind>.…), to pass to other operations; absent when SOLIDWORKS cannot give one. References are opaque: pass one back exactly as it was given, and never build or change one."
              },
              "name": {
                "type": "string",
                "description": "Its name, for features, planes, axes and points."
              },
              "feature": {
                "type": "string",
                "description": "The feature that made it, for faces, edges and vertices. An edge or vertex where several features meet names the first; see features."
              },
              "features": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "For edges and vertices, every feature that made a face it lies on: the circular edge of a hole cut in a boss belongs to both."
              },
              "geometry": {
                "type": "string",
                "enum": [
                  "plane",
                  "cylinder",
                  "cone",
                  "sphere",
                  "torus",
                  "line",
                  "circle",
                  "ellipse",
                  "spline",
                  "point",
                  "other"
                ],
                "description": "Its shape: plane, cylinder, cone, sphere, torus, line, circle, ellipse, spline, point or other."
              },
              "area_mm2": {
                "type": "number",
                "description": "Area of a face, mm²."
              },
              "length_mm": {
                "type": "number",
                "description": "Length of an edge, mm."
              },
              "normal": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "description": "X component."
                  },
                  "y": {
                    "type": "number",
                    "description": "Y component."
                  },
                  "z": {
                    "type": "number",
                    "description": "Z component."
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false,
                "description": "Outward normal of a planar face, or the normal of a plane."
              },
              "axis": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "description": "X component."
                  },
                  "y": {
                    "type": "number",
                    "description": "Y component."
                  },
                  "z": {
                    "type": "number",
                    "description": "Z component."
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false,
                "description": "Axis of a cylinder, cone, circle or axis; direction of a line."
              },
              "origin": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "description": "X, mm."
                  },
                  "y": {
                    "type": "number",
                    "description": "Y, mm."
                  },
                  "z": {
                    "type": "number",
                    "description": "Z, mm."
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false,
                "description": "A point on it: a planar face's or edge's centre, a circle's or cylinder's centre on its axis, a vertex or point itself."
              },
              "radius_mm": {
                "type": "number",
                "description": "Radius of a cylinder, cone base, sphere, torus or circle, mm."
              },
              "box": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "description": "X, mm."
                      },
                      "y": {
                        "type": "number",
                        "description": "Y, mm."
                      },
                      "z": {
                        "type": "number",
                        "description": "Z, mm."
                      }
                    },
                    "required": [
                      "x",
                      "y",
                      "z"
                    ],
                    "additionalProperties": false,
                    "description": "The corner with the smallest coordinates."
                  },
                  "max": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "description": "X, mm."
                      },
                      "y": {
                        "type": "number",
                        "description": "Y, mm."
                      },
                      "z": {
                        "type": "number",
                        "description": "Z, mm."
                      }
                    },
                    "required": [
                      "x",
                      "y",
                      "z"
                    ],
                    "additionalProperties": false,
                    "description": "The corner with the largest coordinates."
                  }
                },
                "required": [
                  "min",
                  "max"
                ],
                "additionalProperties": false,
                "description": "Its axis-aligned bounding box, for faces only."
              },
              "distance_mm": {
                "type": "number",
                "description": "Distance from the point model.find was asked to be near, mm."
              }
            },
            "required": [
              "kind",
              "geometry"
            ],
            "additionalProperties": false,
            "description": "It, with its reference; absent when it is nothing the add-in can name (an annotation, a temporary axis)."
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      },
      "description": "What is selected now, the first 100 when more are (see total; selection.get reads more); empty when the selection was cleared."
    }
  },
  "required": [
    "title",
    "total",
    "items"
  ],
  "additionalProperties": false
}
