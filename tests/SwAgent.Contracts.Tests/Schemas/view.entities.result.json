{
  "type": "object",
  "description": "What a view shows.",
  "properties": {
    "view": {
      "type": "string",
      "description": "The view."
    },
    "model": {
      "type": "string",
      "description": "Full path of its model."
    },
    "scale": {
      "type": "number",
      "description": "The view's scale as a number (0.5 for 1:2)."
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "An entity of the model as a view shows it.",
        "properties": {
          "reference": {
            "type": "string",
            "description": "Its model reference, issued in the part from the part's own entity and checked to name exactly this one; absent when SOLIDWORKS gives none that can be checked (a silhouette edge, or a view proxy SOLIDWORKS maps to no entity of the part), never one another entity shares. References are opaque: pass one back exactly as it was given, and never build or change one."
          },
          "kind": {
            "type": "string",
            "enum": [
              "face",
              "edge",
              "vertex",
              "feature",
              "sketch",
              "sketch_entity",
              "sketch_point",
              "plane",
              "axis",
              "point",
              "dimension",
              "component",
              "mate",
              "sheet",
              "view",
              "annotation",
              "table"
            ],
            "description": "edge or vertex."
          },
          "silhouette": {
            "type": "boolean",
            "description": "True for a silhouette edge (the outline of a curved face), which has no edge of its own in the model."
          },
          "shape": {
            "type": "string",
            "enum": [
              "line",
              "circle",
              "arc",
              "point",
              "other"
            ],
            "description": "How it is drawn: line, circle, arc, point or other."
          },
          "start": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "description": "Mm to the right of the sheet's lower-left corner."
              },
              "y": {
                "type": "number",
                "description": "Mm above the sheet's lower-left corner."
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false,
            "description": "A line's start, or a point's position, sheet mm."
          },
          "end": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "description": "Mm to the right of the sheet's lower-left corner."
              },
              "y": {
                "type": "number",
                "description": "Mm above the sheet's lower-left corner."
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false,
            "description": "A line's end, sheet mm."
          },
          "centre": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "description": "Mm to the right of the sheet's lower-left corner."
              },
              "y": {
                "type": "number",
                "description": "Mm above the sheet's lower-left corner."
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false,
            "description": "A circle's or arc's centre, sheet mm."
          },
          "radius_mm": {
            "type": "number",
            "description": "A circle's or arc's radius as drawn, sheet mm (the model's radius times the view's scale)."
          },
          "entity": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "face",
                  "edge",
                  "vertex",
                  "feature",
                  "sketch",
                  "sketch_entity",
                  "sketch_point",
                  "plane",
                  "axis",
                  "point",
                  "dimension",
                  "component",
                  "mate",
                  "sheet",
                  "view",
                  "annotation",
                  "table"
                ],
                "description": "What it is."
              },
              "reference": {
                "type": "string",
                "description": "Its persistent reference (r1.<kind>.…), to pass to other operations; absent when SOLIDWORKS cannot give one. References are opaque: pass one back exactly as it was given, and never build or change one."
              },
              "name": {
                "type": "string",
                "description": "Its name, for features, planes, axes and points."
              },
              "component": {
                "type": "string",
                "description": "In an assembly, the component it belongs to (bracket-1; sub-1/pin-1 inside a subassembly); absent for the assembly's own planes, axes and origin, and in a part. Its position, direction and box are in the assembly's coordinates."
              },
              "feature": {
                "type": "string",
                "description": "The feature that made it, for faces, edges and vertices. An edge or vertex where several features meet names the first; see features."
              },
              "features": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "For edges and vertices, every feature that made a face it lies on: the circular edge of a hole cut in a boss belongs to both."
              },
              "geometry": {
                "type": "string",
                "enum": [
                  "plane",
                  "cylinder",
                  "cone",
                  "sphere",
                  "torus",
                  "line",
                  "circle",
                  "ellipse",
                  "spline",
                  "point",
                  "other"
                ],
                "description": "Its shape: plane, cylinder, cone, sphere, torus, line, circle, ellipse, spline, point or other."
              },
              "area_mm2": {
                "type": "number",
                "description": "Area of a face, mm²."
              },
              "length_mm": {
                "type": "number",
                "description": "Length of an edge, mm."
              },
              "normal": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "description": "X component."
                  },
                  "y": {
                    "type": "number",
                    "description": "Y component."
                  },
                  "z": {
                    "type": "number",
                    "description": "Z component."
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false,
                "description": "Outward normal of a planar face, or the normal of a plane."
              },
              "axis": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "description": "X component."
                  },
                  "y": {
                    "type": "number",
                    "description": "Y component."
                  },
                  "z": {
                    "type": "number",
                    "description": "Z component."
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false,
                "description": "Axis of a cylinder, cone, circle or axis; direction of a line."
              },
              "origin": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "description": "X, mm."
                  },
                  "y": {
                    "type": "number",
                    "description": "Y, mm."
                  },
                  "z": {
                    "type": "number",
                    "description": "Z, mm."
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false,
                "description": "A point on it: a planar face's or edge's centre, a circle's or cylinder's centre on its axis, a vertex or point itself."
              },
              "radius_mm": {
                "type": "number",
                "description": "Radius of a cylinder, cone base, sphere, torus or circle, mm."
              },
              "box": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "description": "X, mm."
                      },
                      "y": {
                        "type": "number",
                        "description": "Y, mm."
                      },
                      "z": {
                        "type": "number",
                        "description": "Z, mm."
                      }
                    },
                    "required": [
                      "x",
                      "y",
                      "z"
                    ],
                    "additionalProperties": false,
                    "description": "The corner with the smallest coordinates."
                  },
                  "max": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "description": "X, mm."
                      },
                      "y": {
                        "type": "number",
                        "description": "Y, mm."
                      },
                      "z": {
                        "type": "number",
                        "description": "Z, mm."
                      }
                    },
                    "required": [
                      "x",
                      "y",
                      "z"
                    ],
                    "additionalProperties": false,
                    "description": "The corner with the largest coordinates."
                  }
                },
                "required": [
                  "min",
                  "max"
                ],
                "additionalProperties": false,
                "description": "Its axis-aligned bounding box, for faces only."
              },
              "distance_mm": {
                "type": "number",
                "description": "Distance from the point model.find was asked to be near, mm."
              }
            },
            "required": [
              "kind",
              "geometry"
            ],
            "additionalProperties": false,
            "description": "The entity in the model: its shape and measurements in model mm."
          }
        },
        "required": [
          "kind",
          "silhouette",
          "shape"
        ],
        "additionalProperties": false
      },
      "description": "Each entity it shows: edges first, then vertices."
    }
  },
  "required": [
    "view",
    "model",
    "scale",
    "entities"
  ],
  "additionalProperties": false
}
