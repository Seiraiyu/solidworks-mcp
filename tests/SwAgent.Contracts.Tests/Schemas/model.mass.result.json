{
  "type": "object",
  "description": "A part's or assembly's mass properties. All zero, with no centre of mass, when it has no solid body.",
  "properties": {
    "document": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The document's title as SOLIDWORKS shows it."
        },
        "path": {
          "type": "string",
          "description": "The full path, absent while the document has never been saved."
        },
        "type": {
          "type": "string",
          "enum": [
            "part",
            "assembly",
            "drawing"
          ],
          "description": "Part, assembly or drawing."
        },
        "dirty": {
          "type": "boolean",
          "description": "True when the document has unsaved changes."
        },
        "visible": {
          "type": "boolean",
          "description": "False for a document SOLIDWORKS loaded only because an open assembly uses it: it has no window of its own."
        }
      },
      "required": [
        "title",
        "type",
        "dirty",
        "visible"
      ],
      "additionalProperties": false,
      "description": "The part or assembly."
    },
    "bodies": {
      "type": "integer",
      "description": "How many solid bodies it has (an assembly: its resolved components' bodies)."
    },
    "volume_mm3": {
      "type": "number",
      "description": "Volume, mm³."
    },
    "area_mm2": {
      "type": "number",
      "description": "Surface area, mm²."
    },
    "mass_g": {
      "type": "number",
      "description": "Mass, g."
    },
    "density_kg_m3": {
      "type": "number",
      "description": "Density used, kg/m³ (SOLIDWORKS' default when no material is set); for an assembly, its mass over its volume."
    },
    "material": {
      "type": "string",
      "description": "The material's name; absent when none is set, and for an assembly."
    },
    "center_of_mass": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "description": "X, mm."
        },
        "y": {
          "type": "number",
          "description": "Y, mm."
        },
        "z": {
          "type": "number",
          "description": "Z, mm."
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "additionalProperties": false,
      "description": "Centre of mass, mm."
    },
    "principal_moments_g_mm2": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Principal moments of inertia at the centre of mass, g·mm², smallest first."
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "One component's share of an assembly's mass properties, in the assembly's coordinates.",
        "properties": {
          "name": {
            "type": "string",
            "description": "The component's name, for example bracket-1."
          },
          "volume_mm3": {
            "type": "number",
            "description": "Its volume, mm³."
          },
          "mass_g": {
            "type": "number",
            "description": "Its mass, g."
          },
          "center_of_mass": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "description": "X, mm."
              },
              "y": {
                "type": "number",
                "description": "Y, mm."
              },
              "z": {
                "type": "number",
                "description": "Z, mm."
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "additionalProperties": false,
            "description": "Its centre of mass in the assembly, mm; absent when it has no solid body."
          }
        },
        "required": [
          "name",
          "volume_mm3",
          "mass_g"
        ],
        "additionalProperties": false
      },
      "description": "For an assembly, each top-level component that is not suppressed or missing, in tree order (a subassembly as a whole); absent for a part."
    }
  },
  "required": [
    "document",
    "bodies",
    "volume_mm3",
    "area_mm2",
    "mass_g",
    "density_kg_m3",
    "principal_moments_g_mm2"
  ],
  "additionalProperties": false
}
