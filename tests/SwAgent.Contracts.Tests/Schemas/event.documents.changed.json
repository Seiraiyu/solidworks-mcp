{
  "type": "object",
  "description": "The open documents changed: one opened or closed, or a dirty flag changed.",
  "properties": {
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "A document open in SOLIDWORKS.",
        "properties": {
          "title": {
            "type": "string",
            "description": "The document's title as SOLIDWORKS shows it."
          },
          "path": {
            "type": "string",
            "description": "The full path, absent while the document has never been saved."
          },
          "type": {
            "type": "string",
            "enum": [
              "part",
              "assembly",
              "drawing"
            ],
            "description": "Part, assembly or drawing."
          },
          "dirty": {
            "type": "boolean",
            "description": "True when the document has unsaved changes."
          }
        },
        "required": [
          "title",
          "type",
          "dirty"
        ],
        "additionalProperties": false
      },
      "description": "Every open document, with its dirty flag."
    }
  },
  "required": [
    "documents"
  ],
  "additionalProperties": false
}
