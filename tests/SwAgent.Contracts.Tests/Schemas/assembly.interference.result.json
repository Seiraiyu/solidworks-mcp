{
  "type": "object",
  "description": "The interferences found.",
  "properties": {
    "document": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The document's title as SOLIDWORKS shows it."
        },
        "path": {
          "type": "string",
          "description": "The full path, absent while the document has never been saved."
        },
        "type": {
          "type": "string",
          "enum": [
            "part",
            "assembly",
            "drawing"
          ],
          "description": "Part, assembly or drawing."
        },
        "dirty": {
          "type": "boolean",
          "description": "True when the document has unsaved changes."
        },
        "visible": {
          "type": "boolean",
          "description": "False for a document SOLIDWORKS loaded only because an open assembly uses it: it has no window of its own."
        }
      },
      "required": [
        "title",
        "type",
        "dirty",
        "visible"
      ],
      "additionalProperties": false,
      "description": "The assembly."
    },
    "interferences": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "Two components that overlap.",
        "properties": {
          "components": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The two components' names (sub-1/pin-1 inside a subassembly)."
          },
          "volume_mm3": {
            "type": "number",
            "description": "The volume of the overlap, mm³; 0 for faces that only touch."
          },
          "box": {
            "type": "object",
            "properties": {
              "min": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "description": "X, mm."
                  },
                  "y": {
                    "type": "number",
                    "description": "Y, mm."
                  },
                  "z": {
                    "type": "number",
                    "description": "Z, mm."
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false,
                "description": "The corner with the smallest coordinates."
              },
              "max": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "description": "X, mm."
                  },
                  "y": {
                    "type": "number",
                    "description": "Y, mm."
                  },
                  "z": {
                    "type": "number",
                    "description": "Z, mm."
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false,
                "description": "The corner with the largest coordinates."
              }
            },
            "required": [
              "min",
              "max"
            ],
            "additionalProperties": false,
            "description": "The box around the overlap, mm in the assembly; absent when SOLIDWORKS gives none."
          },
          "touching": {
            "type": "boolean",
            "description": "True when the components only touch (coincident faces, no volume)."
          }
        },
        "required": [
          "components",
          "volume_mm3",
          "touching"
        ],
        "additionalProperties": false
      },
      "description": "Each interference reported, largest volume first."
    },
    "total_volume_mm3": {
      "type": "number",
      "description": "The sum of their volumes, mm³."
    },
    "components": {
      "type": "integer",
      "description": "How many components the assembly has, nested ones included: what SOLIDWORKS checked."
    },
    "marked_dirty": {
      "type": "boolean",
      "description": "True when SOLIDWORKS' interference session marked an assembly that had no unsaved changes as having them (seen on SOLIDWORKS 2026 SP4; the API cannot clear the flag). Nothing in the model changed: the components are where they were, and the assembly was not saved to clear the flag."
    }
  },
  "required": [
    "document",
    "interferences",
    "total_volume_mm3",
    "components",
    "marked_dirty"
  ],
  "additionalProperties": false
}
